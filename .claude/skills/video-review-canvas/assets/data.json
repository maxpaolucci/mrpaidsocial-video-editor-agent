{
  "collections": {
    "comments": {
      "fields": {
        "t": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 7200
        },
        "text": {
          "type": "string",
          "required": true,
          "maxLength": 1000,
          "trim": true
        },
        "author": {
          "type": "string",
          "maxLength": 60,
          "trim": true,
          "default": "Reviewer"
        },
        "version": {
          "type": "string",
          "maxLength": 20,
          "default": "v1"
        },
        "frame": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "minimum": 0.001
        }
      },
      "access": {
        "read": "public",
        "insert": "public",
        "update": "owner",
        "delete": "owner"
      },
      "rateLimit": "300/hour/ip"
    },
    "review_events": {
      "fields": {
        "comment_id": {
          "type": "string",
          "required": true,
          "maxLength": 1000
        },
        "kind": {
          "type": "string",
          "required": true,
          "maxLength": 20
        },
        "author": {
          "type": "string",
          "maxLength": 60,
          "trim": true,
          "default": "Reviewer"
        },
        "review_status": {
          "type": "string",
          "maxLength": 20
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "trim": true
        },
        "before_version": {
          "type": "string",
          "maxLength": 60
        },
        "before_t": {
          "type": "number",
          "minimum": 0
        },
        "before_frame": {
          "type": "number",
          "minimum": 0
        },
        "after_version": {
          "type": "string",
          "maxLength": 60
        },
        "after_t": {
          "type": "number",
          "minimum": 0
        },
        "after_frame": {
          "type": "number",
          "minimum": 0
        }
      },
      "access": {
        "read": "public",
        "insert": "public",
        "update": "owner",
        "delete": "owner"
      },
      "rateLimit": "300/hour/ip"
    }
  }
}
